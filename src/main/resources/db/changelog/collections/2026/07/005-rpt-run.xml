<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- rpt_run is the ONE table rpt owns. rpt is a one-shot schema-owner job rather than an
         orchestrated AGT stage, so it records its own outcome-seam name here: one row per run,
         keyed by the seam job_name (the K8s Job name, else local-rpt-<executionId>).

         No MARK_RAN tableExists guard. On version 1 the database is empty, rpt is the table's only
         creator, and a guard for an object that cannot exist would convert a genuine failure
         (someone else created rpt_run) into a silent skip. -->
    <changeSet id="005-rpt-run" author="dcre">
        <createTable tableName="rpt_run">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="job_name" type="VARCHAR(63)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_rpt_run_job"/>
            </column>
            <column name="outcome" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="rpt_run"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
