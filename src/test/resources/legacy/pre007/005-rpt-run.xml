<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        logicalFilePath="db/changelog/2026/07/005-rpt-run.xml"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- SCRUM-58 file-trace: rpt is a one-shot schema-owner job (its real work is the Liquibase
         runs), NOT an orchestrated AGT stage, so it captures its own outcome-seam name here.
         One row per rpt job run, keyed by the seam job_name (K8s Job name, else
         local-rpt-<executionId>). MARK_RAN tableExists guard keeps the additive create re-run-safe
         on already-migrated databases (persistence.md changeset-identity rule). -->
    <changeSet id="005-rpt-run" author="dcre">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="rpt_run"/></not>
        </preConditions>
        <createTable tableName="rpt_run">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="job_name" type="VARCHAR(63)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_rpt_run_job"/>
            </column>
            <column name="outcome" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="rpt_run"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
